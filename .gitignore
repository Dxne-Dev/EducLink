# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.crlf_check

# binary fonts (served from public/fonts/ instead)
*.otf
*.ttf
*.woff
*.woff2

# internal design docs (not source code)
DESIGN.md
DESIGN2.md
look-ui.md
session.md

# favicon source assets (actual favicons live in public/)
favicon_io/

# environment & secrets
.env
.env.*
!.env.example
# debug & tooling artifacts (chrome capture profile, agent worktrees, AI tool settings)
.repro/
.kilo/
.claude/settings.local.json

# dev logs
*.log

# keep the active app font (loaded by next/font in src/app/layout.tsx)
!src/app/amatry.otf

# supabase CLI cache & test leftovers
supabase/.temp/
*.crlf_check
